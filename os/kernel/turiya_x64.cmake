# The seL4 configuration of the kernel Turiya runs: every Kernel*/LibSel4* option of the tested build
# (os/kernel/CONFIG.md explains the ones that differ from configs/X64_verified.cmake). Used as an initial cache:
#   cmake -G Ninja -DCMAKE_TOOLCHAIN_FILE=<seL4>/gcc.cmake -C os/kernel/turiya_x64.cmake -S <seL4> -B <build>

set(KernelArch "x86" CACHE STRING "")
set(KernelBenchmarks "none" CACHE STRING "")
set(KernelCacheLnSz "64" CACHE STRING "")
set(KernelClz32 "OFF" CACHE BOOL "")
set(KernelClz64 "OFF" CACHE BOOL "")
set(KernelClzNoBuiltin "OFF" CACHE BOOL "")
set(KernelColourPrinting "ON" CACHE BOOL "")
set(KernelCtz32 "OFF" CACHE BOOL "")
set(KernelCtz64 "OFF" CACHE BOOL "")
set(KernelCtzNoBuiltin "OFF" CACHE BOOL "")
set(KernelDangerousCodeInjection "OFF" CACHE BOOL "")
set(KernelDebugBuild "ON" CACHE BOOL "")
set(KernelDebugDisablePrefetchers "OFF" CACHE BOOL "")
set(KernelExportPMCUser "OFF" CACHE BOOL "")
set(KernelFPU "XSAVE" CACHE STRING "")
set(KernelFPUMaxRestoresSinceSwitch "64" CACHE STRING "")
set(KernelFSGSBase "msr" CACHE STRING "")
set(KernelFWholeProgram "OFF" CACHE BOOL "")
set(KernelFastpath "ON" CACHE BOOL "")
set(KernelHugePage "ON" CACHE BOOL "")
set(KernelIOMMU "ON" CACHE BOOL "")
set(KernelIRQController "IOAPIC" CACHE STRING "")
set(KernelIRQReporting "ON" CACHE BOOL "")
set(KernelInvocationReportErrorIPC "OFF" CACHE BOOL "")
set(KernelIsMCS "OFF" CACHE BOOL "")
set(KernelLAPICMode "XAPIC" CACHE STRING "")
set(KernelMaxNumBootinfoUntypedCaps "230" CACHE STRING "")
set(KernelMaxNumIOAPIC "1" CACHE STRING "")
set(KernelMaxNumWorkUnitsPerPreemption "100" CACHE STRING "")
set(KernelMaxRMRREntries "32" CACHE STRING "")
set(KernelMultiboot1Header "ON" CACHE BOOL "")
set(KernelMultiboot2Header "ON" CACHE BOOL "")
set(KernelMultibootGFXMode "none" CACHE STRING "")
set(KernelNumDomains "16" CACHE STRING "")
set(KernelNumPriorities "256" CACHE STRING "")
set(KernelOptimisation "-O2" CACHE STRING "")
set(KernelOptimisationCloneFunctions "ON" CACHE BOOL "")
set(KernelPC99TSCFrequency "0" CACHE STRING "")
set(KernelPlatform "pc99" CACHE STRING "")
set(KernelPrinting "ON" CACHE BOOL "")
set(KernelResetChunkBits "8" CACHE STRING "")
set(KernelRetypeFanOutLimit "256" CACHE STRING "")
set(KernelRootCNodeSizeBits "19" CACHE STRING "")
set(KernelSel4Arch "x86_64" CACHE STRING "")
set(KernelSkimWindow "OFF" CACHE BOOL "")
set(KernelStackBits "12" CACHE STRING "")
set(KernelSupportPCID "OFF" CACHE BOOL "")
set(KernelSyscall "syscall" CACHE STRING "")
set(KernelTimeSlice "5" CACHE STRING "")
set(KernelTimerTickMS "2" CACHE STRING "")
set(KernelUserStackTraceLength "16" CACHE STRING "")
set(KernelVTX "OFF" CACHE BOOL "")
set(KernelVerificationBuild "OFF" CACHE BOOL "")
set(KernelX86DangerousMSR "OFF" CACHE BOOL "")
set(KernelX86IBPBOnContextSwitch "OFF" CACHE BOOL "")
set(KernelX86IBRSMode "ibrs_none" CACHE STRING "")
set(KernelX86MicroArch "nehalem" CACHE STRING "")
set(KernelX86RSBOnContextSwitch "OFF" CACHE BOOL "")
set(KernelXSave "XSAVE" CACHE STRING "")
set(KernelXSaveFeatureSet "3" CACHE STRING "")
set(KernelXSaveSize "1024" CACHE STRING "")
set(LibSel4FunctionAttributes "inline" CACHE STRING "")
set(LibSel4StubsUseIPCBufferOnly "OFF" CACHE BOOL "")
